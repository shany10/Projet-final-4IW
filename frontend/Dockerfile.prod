FROM node:22-bookworm-slim AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci --no-audit --no-fund

COPY . .

# @sentry/nuxt n'est ajoute au build QUE si un DSN est present au moment du build
# (voir nuxt.config.ts). On passe donc les DSN en build args pour que le suivi
# d'erreurs frontend (navigateur) et SSR soit reellement embarque en production.
# La valeur reelle du DSN reste surchargeable au runtime via l'environnement.
ARG NUXT_PUBLIC_SENTRY_DSN=""
ARG SENTRY_SERVER_DSN=""
ENV NUXT_PUBLIC_SENTRY_DSN=$NUXT_PUBLIC_SENTRY_DSN
ENV SENTRY_SERVER_DSN=$SENTRY_SERVER_DSN

# Le script Umami est injecte dans <head> au moment du build (nuxt.config.ts),
# uniquement si l'URL du script ET l'id du site sont presents. On les passe donc
# aussi en build args, sinon la balise <script> Umami n'est pas embarquee.
ARG NUXT_PUBLIC_UMAMI_SRC=""
ARG NUXT_PUBLIC_UMAMI_WEBSITE_ID=""
ENV NUXT_PUBLIC_UMAMI_SRC=$NUXT_PUBLIC_UMAMI_SRC
ENV NUXT_PUBLIC_UMAMI_WEBSITE_ID=$NUXT_PUBLIC_UMAMI_WEBSITE_ID

RUN npm run build

FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production
ENV NITRO_HOST=0.0.0.0
ENV NITRO_PORT=3001

COPY --from=builder --chown=node:node /app/.output ./.output

USER node
EXPOSE 3001
CMD ["node", ".output/server/index.mjs"]
